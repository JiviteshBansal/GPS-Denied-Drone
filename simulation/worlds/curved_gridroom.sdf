<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="curved_gridroom">
    <!-- ============================================================== -->
    <!-- Gazebo Harmonic Physics Configuration                          -->
    <!-- 1000 Hz physics step size for high-fidelity multirotor stability-->
    <!-- ============================================================== -->
    <physics name="harmonic_ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Standard Gazebo Harmonic systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- ============================================================== -->
    <!-- Indoor Lighting & Atmosphere (GPS-Denied Enclosed Bunker)       -->
    <!-- ============================================================== -->
    <scene>
      <ambient>0.35 0.35 0.38 1.0</ambient>
      <background>0.10 0.12 0.15 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Industrial Ceiling Fixtures -->
    <light name="ceiling_light_center" type="point">
      <pose>0 0 4.5 0 0 0</pose>
      <diffuse>0.85 0.85 0.90 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
      <attenuation>
        <range>25</range>
        <constant>0.2</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <light name="ceiling_light_west" type="point">
      <pose>-8 0 4.5 0 0 0</pose>
      <diffuse>0.75 0.75 0.80 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <attenuation>
        <range>20</range>
        <constant>0.2</constant>
        <linear>0.08</linear>
        <quadratic>0.015</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <light name="ceiling_light_east" type="point">
      <pose>8 0 4.5 0 0 0</pose>
      <diffuse>0.75 0.75 0.80 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <attenuation>
        <range>20</range>
        <constant>0.2</constant>
        <linear>0.08</linear>
        <quadratic>0.015</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- ============================================================== -->
    <!-- Floor and Ceiling Structure                                    -->
    <!-- ============================================================== -->
    <!-- Concrete Ground Floor -->
    <model name="facility_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>36.0 30.0 0.2</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>36.0 30.0 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.42 0.45 1.0</ambient>
            <diffuse>0.5 0.52 0.55 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.1 0 0 0</pose>
    </model>

    <!-- Enclosed Ceiling -->
    <model name="facility_ceiling">
      <static>true</static>
      <link name="ceiling_link">
        <collision name="ceiling_collision">
          <geometry>
            <box>
              <size>36.0 30.0 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="ceiling_visual">
          <geometry>
            <box>
              <size>36.0 30.0 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.22 0.25 1.0</ambient>
            <diffuse>0.3 0.32 0.35 1.0</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 5.1 0 0 0</pose>
    </model>

    <!-- Perimeter Boundary Walls (36m x 30m x 5m) -->
    <model name="outer_perimeter_walls">
      <static>true</static>
      <link name="walls_link">
        <!-- North Wall -->
        <collision name="wall_north_col">
          <pose>0 15 2.5 0 0 0</pose>
          <geometry><box><size>36.0 0.4 5.0</size></box></geometry>
        </collision>
        <visual name="wall_north_vis">
          <pose>0 15 2.5 0 0 0</pose>
          <geometry><box><size>36.0 0.4 5.0</size></box></geometry>
          <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.4 0.42 0.45 1</diffuse></material>
        </visual>

        <!-- South Wall -->
        <collision name="wall_south_col">
          <pose>0 -15 2.5 0 0 0</pose>
          <geometry><box><size>36.0 0.4 5.0</size></box></geometry>
        </collision>
        <visual name="wall_south_vis">
          <pose>0 -15 2.5 0 0 0</pose>
          <geometry><box><size>36.0 0.4 5.0</size></box></geometry>
          <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.4 0.42 0.45 1</diffuse></material>
        </visual>

        <!-- East Wall -->
        <collision name="wall_east_col">
          <pose>18 0 2.5 0 0 0</pose>
          <geometry><box><size>0.4 30.0 5.0</size></box></geometry>
        </collision>
        <visual name="wall_east_vis">
          <pose>18 0 2.5 0 0 0</pose>
          <geometry><box><size>0.4 30.0 5.0</size></box></geometry>
          <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.4 0.42 0.45 1</diffuse></material>
        </visual>

        <!-- West Wall -->
        <collision name="wall_west_col">
          <pose>-18 0 2.5 0 0 0</pose>
          <geometry><box><size>0.4 30.0 5.0</size></box></geometry>
        </collision>
        <visual name="wall_west_vis">
          <pose>-18 0 2.5 0 0 0</pose>
          <geometry><box><size>0.4 30.0 5.0</size></box></geometry>
          <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.4 0.42 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- Curved Gridroom Walls & Corridors                              -->
    <!-- Cylindrical arcs & curved obstacle corridors                   -->
    <!-- ============================================================== -->
    <!-- Central Curved Barrier Arc (West side curve) -->
    <model name="curved_wall_west">
      <static>true</static>
      <link name="curved_wall_west_link">
        <pose>-6.0 2.0 2.5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>4.5</radius>
              <length>5.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.45 0.35 0.3 1</ambient>
            <diffuse>0.6 0.45 0.35 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>4.5</radius>
              <length>5.0</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Central Curved Barrier Arc (East side curve) -->
    <model name="curved_wall_east">
      <static>true</static>
      <link name="curved_wall_east_link">
        <pose>6.0 3.0 2.5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>4.0</radius>
              <length>5.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.4 0.45 1</ambient>
            <diffuse>0.35 0.5 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>4.0</radius>
              <length>5.0</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Southern Curved Chicane -->
    <model name="curved_chicane_south">
      <static>true</static>
      <link name="curved_chicane_link">
        <pose>0.0 -7.0 2.5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>2.2</radius>
              <length>5.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>2.2</radius>
              <length>5.0</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- Gridroom Structured Columns (Subterranean Grid Pattern)        -->
    <!-- ============================================================== -->
    <!-- Pillar 1 (Grid -10, -5) -->
    <model name="grid_pillar_1">
      <static>true</static>
      <pose>-11.0 -6.0 2.5 0 0 0</pose>
      <link name="pillar_link">
        <collision name="col"><geometry><box><size>1.2 1.2 5.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 1.2 5.0</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pillar 2 (Grid +11, -6) -->
    <model name="grid_pillar_2">
      <static>true</static>
      <pose>11.0 -6.0 2.5 0 0 0</pose>
      <link name="pillar_link">
        <collision name="col"><geometry><box><size>1.2 1.2 5.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 1.2 5.0</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pillar 3 (Grid -11, +7) -->
    <model name="grid_pillar_3">
      <static>true</static>
      <pose>-11.0 8.0 2.5 0 0 0</pose>
      <link name="pillar_link">
        <collision name="col"><geometry><box><size>1.2 1.2 5.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 1.2 5.0</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pillar 4 (Grid +11, +8) -->
    <model name="grid_pillar_4">
      <static>true</static>
      <pose>11.0 8.0 2.5 0 0 0</pose>
      <link name="pillar_link">
        <collision name="col"><geometry><box><size>1.2 1.2 5.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 1.2 5.0</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Internal Partition Wall (Creating Non-Trivial Exploration Corridors) -->
    <model name="partition_wall_north">
      <static>true</static>
      <pose>0.0 10.0 2.5 0 0 0</pose>
      <link name="partition_link">
        <collision name="col"><geometry><box><size>14.0 0.5 5.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>14.0 0.5 5.0</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- Multi-Drone Spawn Setup (3 Iris Quadcopters)                   -->
    <!-- drone_1: (-4.0, -6.0, 0.2) | MAVLink Port 14540                -->
    <!-- drone_2: ( 0.0, -6.0, 0.2) | MAVLink Port 14541                -->
    <!-- drone_3: ( 4.0, -6.0, 0.2) | MAVLink Port 14542                -->
    <!-- ============================================================== -->
    <!-- Drone 1 -->
    <include>
      <name>drone_1</name>
      <uri>model://quadrotor_px4</uri>
      <pose>-4.0 -6.0 0.2 0 0 0</pose>
    </include>

    <!-- Drone 2 -->
    <include>
      <name>drone_2</name>
      <uri>model://quadrotor_px4</uri>
      <pose>0.0 -6.0 0.2 0 0 0</pose>
    </include>

    <!-- Drone 3 -->
    <include>
      <name>drone_3</name>
      <uri>model://quadrotor_px4</uri>
      <pose>4.0 -6.0 0.2 0 0 0</pose>
    </include>

  </world>
</sdf>
