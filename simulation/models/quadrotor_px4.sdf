<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="quadrotor_px4">
    <!-- Initial pose (can be overridden by launch / world spawn) -->
    <pose>0 0 0.2 0 0 0</pose>
    <static>false</static>

    <!-- ========================================== -->
    <!-- Airframe & Fuselage Physical Properties    -->
    <!-- Standard 3DR Iris / Research Quadrotor     -->
    <!-- Total Mass: ~1.50 kg                       -->
    <!-- ========================================== -->
    <link name="base_link">
      <inertial>
        <mass>1.50</mass>
        <inertia>
          <ixx>0.029125</ixx>
          <iyy>0.029125</iyy>
          <izz>0.055225</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="fuselage_visual">
        <geometry>
          <box>
            <size>0.28 0.28 0.11</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.18 1.0</ambient>
          <diffuse>0.25 0.25 0.30 1.0</diffuse>
          <specular>0.6 0.6 0.6 1.0</specular>
        </material>
      </visual>

      <collision name="fuselage_collision">
        <geometry>
          <box>
            <size>0.28 0.28 0.11</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.005</min_depth>
              <kp>1e6</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Autopilot Core IMU (PX4 EKF2 Primary) -->
      <sensor name="autopilot_imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0003</stddev>
                <bias_mean>0.0001</bias_mean>
                <bias_stddev>0.00002</bias_stddev>
                <dynamic_bias_stddev>0.000005</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0003</stddev>
                <bias_mean>0.0001</bias_mean>
                <bias_stddev>0.00002</bias_stddev>
                <dynamic_bias_stddev>0.000005</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0003</stddev>
                <bias_mean>0.0001</bias_mean>
                <bias_stddev>0.00002</bias_stddev>
                <dynamic_bias_stddev>0.000005</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0025</stddev>
                <bias_mean>0.002</bias_mean>
                <bias_stddev>0.0005</bias_stddev>
                <dynamic_bias_stddev>0.0001</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0025</stddev>
                <bias_mean>0.002</bias_mean>
                <bias_stddev>0.0005</bias_stddev>
                <dynamic_bias_stddev>0.0001</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0025</stddev>
                <bias_mean>0.002</bias_mean>
                <bias_stddev>0.0005</bias_stddev>
                <dynamic_bias_stddev>0.0001</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ============================================================== -->
    <!-- Intel RealSense D435i Sensor Suite                             -->
    <!-- Forward mount: Stereo IR (Left/Right) @ 30Hz + IMU @ 200Hz     -->
    <!-- Allan Variance Noise Profile: Bosch BMI085 6-DoF               -->
    <!-- ============================================================== -->
    <link name="d435i_link">
      <pose relative_to="base_link">0.14 0 0 0 0 0</pose>
      <inertial>
        <mass>0.072</mass>
        <inertia>
          <ixx>0.000015</ixx>
          <iyy>0.000045</iyy>
          <izz>0.000045</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- D435i Physical Casing Visual -->
      <visual name="d435i_visual">
        <geometry>
          <box>
            <size>0.025 0.090 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.65 1.0</ambient>
          <diffuse>0.7 0.7 0.75 1.0</diffuse>
          <specular>0.8 0.8 0.8 1.0</specular>
        </material>
      </visual>

      <collision name="d435i_collision">
        <geometry>
          <box>
            <size>0.025 0.090 0.025</size>
          </box>
        </geometry>
      </collision>

      <!-- 1. D435i Onboard IMU (BMI085) with Allan Variance Noise Profile @ 200Hz -->
      <sensor name="d435i_imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>d435i/imu</topic>
        <imu>
          <angular_velocity>
            <!-- BMI085 Gyroscope: Noise Density = 0.00028 rad/s/sqrt(Hz), Bias Stability = 0.00003 rad/s^2/sqrt(Hz) -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00028</stddev>
                <bias_mean>0.00005</bias_mean>
                <bias_stddev>0.00001</bias_stddev>
                <dynamic_bias_stddev>0.00003</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00028</stddev>
                <bias_mean>0.00005</bias_mean>
                <bias_stddev>0.00001</bias_stddev>
                <dynamic_bias_stddev>0.00003</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00028</stddev>
                <bias_mean>0.00005</bias_mean>
                <bias_stddev>0.00001</bias_stddev>
                <dynamic_bias_stddev>0.00003</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- BMI085 Accelerometer: Noise Density = 0.0023 m/s^2/sqrt(Hz), Bias Stability = 0.00018 m/s^3/sqrt(Hz) -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0023</stddev>
                <bias_mean>0.001</bias_mean>
                <bias_stddev>0.0003</bias_stddev>
                <dynamic_bias_stddev>0.00018</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0023</stddev>
                <bias_mean>0.001</bias_mean>
                <bias_stddev>0.0003</bias_stddev>
                <dynamic_bias_stddev>0.00018</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0023</stddev>
                <bias_mean>0.001</bias_mean>
                <bias_stddev>0.0003</bias_stddev>
                <dynamic_bias_stddev>0.00018</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- 2. Left Infrared Camera (infra1) @ 30Hz, 848x480, FOV 87 deg x 58 deg -->
      <!-- Baseline: -0.025m on Y-axis from center -->
      <sensor name="d435i_infra1" type="camera">
        <pose>0 0.025 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>d435i/infra1/image_raw</topic>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>25.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- 3. Right Infrared Camera (infra2) @ 30Hz, 848x480, FOV 87 deg x 58 deg -->
      <!-- Baseline: +0.025m on Y-axis from center (Total Baseline = 50mm) -->
      <sensor name="d435i_infra2" type="camera">
        <pose>0 -0.025 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>d435i/infra2/image_raw</topic>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>25.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- 4. Aligned Hardware Depth Stream @ 30Hz -->
      <sensor name="d435i_depth" type="depth_camera">
        <pose>0 0.025 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>d435i/depth/image_rect_raw</topic>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.15</near>
            <far>15.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.012</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <!-- Rigid mount joint connecting D435i to base_link -->
    <joint name="d435i_joint" type="fixed">
      <parent>base_link</parent>
      <child>d435i_link</child>
    </joint>

    <!-- ========================================== -->
    <!-- 4 Rotors Physical Inertial & Geometries    -->
    <!-- ========================================== -->
    <!-- Front-Left Motor (Rotor 0) -->
    <link name="rotor_0">
      <pose relative_to="base_link">0.13 0.13 0.03 0 0 0</pose>
      <inertial>
        <mass>0.012</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="rotor_0_visual">
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 0.7</ambient>
          <diffuse>0.2 0.2 0.2 0.7</diffuse>
        </material>
      </visual>
      <collision name="rotor_0_collision">
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Front-Right Motor (Rotor 1) -->
    <link name="rotor_1">
      <pose relative_to="base_link">0.13 -0.13 0.03 0 0 0</pose>
      <inertial>
        <mass>0.012</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 0.7</ambient>
          <diffuse>0.2 0.2 0.2 0.7</diffuse>
        </material>
      </visual>
      <collision name="rotor_1_collision">
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Back-Left Motor (Rotor 2) -->
    <link name="rotor_2">
      <pose relative_to="base_link">-0.13 0.13 0.03 0 0 0</pose>
      <inertial>
        <mass>0.012</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 0.7</ambient>
          <diffuse>0.2 0.2 0.2 0.7</diffuse>
        </material>
      </visual>
      <collision name="rotor_2_collision">
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Back-Right Motor (Rotor 3) -->
    <link name="rotor_3">
      <pose relative_to="base_link">-0.13 -0.13 0.03 0 0 0</pose>
      <inertial>
        <mass>0.012</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 0.7</ambient>
          <diffuse>0.2 0.2 0.2 0.7</diffuse>
        </material>
      </visual>
      <collision name="rotor_3_collision">
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- ========================================== -->
    <!-- Revolute Joints for Rotors                 -->
    <!-- ========================================== -->
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ============================================================== -->
    <!-- Gazebo Harmonic Multirotor Physics & Motor Model Systems       -->
    <!-- Aerodynamic thrust curve, rotational drag, PX4 command inputs  -->
    <!-- ============================================================== -->
    <!-- Motor 0: Front-Left (CCW) -->
    <plugin filename="gz-sim-multirotor-motor-model-system" name="gz::sim::systems::MultirotorMotorModel">
      <joint_name>rotor_0_joint</joint_name>
      <link_name>rotor_0</link_name>
      <motor_number>0</motor_number>
      <turning_direction>ccw</turning_direction>
      <max_rotational_velocity>850.0</max_rotational_velocity>
      <motor_constant>8.54858e-06</motor_constant>
      <moment_constant>0.016</moment_constant>
      <rotor_drag_coefficient>8.06428e-05</rotor_drag_coefficient>
      <rolling_moment_coefficient>1e-06</rolling_moment_coefficient>
      <rotor_velocity_slowdown_sim>10</rotor_velocity_slowdown_sim>
    </plugin>

    <!-- Motor 1: Front-Right (CW) -->
    <plugin filename="gz-sim-multirotor-motor-model-system" name="gz::sim::systems::MultirotorMotorModel">
      <joint_name>rotor_1_joint</joint_name>
      <link_name>rotor_1</link_name>
      <motor_number>1</motor_number>
      <turning_direction>cw</turning_direction>
      <max_rotational_velocity>850.0</max_rotational_velocity>
      <motor_constant>8.54858e-06</motor_constant>
      <moment_constant>0.016</moment_constant>
      <rotor_drag_coefficient>8.06428e-05</rotor_drag_coefficient>
      <rolling_moment_coefficient>1e-06</rolling_moment_coefficient>
      <rotor_velocity_slowdown_sim>10</rotor_velocity_slowdown_sim>
    </plugin>

    <!-- Motor 2: Back-Left (CW) -->
    <plugin filename="gz-sim-multirotor-motor-model-system" name="gz::sim::systems::MultirotorMotorModel">
      <joint_name>rotor_2_joint</joint_name>
      <link_name>rotor_2</link_name>
      <motor_number>2</motor_number>
      <turning_direction>cw</turning_direction>
      <max_rotational_velocity>850.0</max_rotational_velocity>
      <motor_constant>8.54858e-06</motor_constant>
      <moment_constant>0.016</moment_constant>
      <rotor_drag_coefficient>8.06428e-05</rotor_drag_coefficient>
      <rolling_moment_coefficient>1e-06</rolling_moment_coefficient>
      <rotor_velocity_slowdown_sim>10</rotor_velocity_slowdown_sim>
    </plugin>

    <!-- Motor 3: Back-Right (CCW) -->
    <plugin filename="gz-sim-multirotor-motor-model-system" name="gz::sim::systems::MultirotorMotorModel">
      <joint_name>rotor_3_joint</joint_name>
      <link_name>rotor_3</link_name>
      <motor_number>3</motor_number>
      <turning_direction>ccw</turning_direction>
      <max_rotational_velocity>850.0</max_rotational_velocity>
      <motor_constant>8.54858e-06</motor_constant>
      <moment_constant>0.016</moment_constant>
      <rotor_drag_coefficient>8.06428e-05</rotor_drag_coefficient>
      <rolling_moment_coefficient>1e-06</rolling_moment_coefficient>
      <rotor_velocity_slowdown_sim>10</rotor_velocity_slowdown_sim>
    </plugin>

  </model>
</sdf>
